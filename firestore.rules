rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['superadmin', 'operador', 'auditor']
      );
    }

    function isWriterAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['superadmin', 'operador']
      );
    }

    function validNewUser(uid) {
      return owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.acessoVitalicio == false
        && request.resource.data.carteiraValidaAte == null
        && request.resource.data.appsCarteira is list
        && request.resource.data.appsCarteira.size() == 1
        && request.resource.data.appsCarteira[0] in ['cbjjb', 'ibcjj'];
    }

    function ownEditableUserFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nome', 'email', 'doc', 'equipe', 'faixa', 'graduacao', 'genero',
        'gênero', 'nascimento', 'peso', 'tecnico', 'telefone',
        'profileImageBase64', 'profileImageUpdatedAt'
      ]);
    }

    match /Usuarios/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if validNewUser(uid) || isWriterAdmin();
      allow update: if (owns(uid) && ownEditableUserFieldsOnly()) || isWriterAdmin();
      allow delete: if owns(uid) || isWriterAdmin();

      match /certificados/{certificateId} {
        allow read: if owns(uid) || isAdmin();
        allow create: if owns(uid)
          && request.resource.data.imageBase64 is string
          && request.resource.data.imageBase64.size() <= 700000;
        allow update: if false;
        allow delete: if owns(uid) || isWriterAdmin();
      }
    }

    match /SolicitacoesAtivacao/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.certificateIds is list
        && request.resource.data.certificateIds.size() > 0;
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isWriterAdmin();
    }

    match /AuditoriaCarteiras/{auditId} {
      allow read: if isAdmin();
      allow create: if isWriterAdmin();
      allow update, delete: if false;
    }

    match /Administradores/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow write: if signedIn() && request.auth.token.role == 'superadmin';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

